{
  "schema": 1,
  "id": "genres-picker",
  "name": "Genres Picker",
  "author": "Pawapps Team",
  "version": "1.0.0",
  "icon": "list",
  "category": "tag-sources",
  "description": {
    "en": "Turns the Genre field from free input into a dropdown with a fixed list of genres.",
    "es": "Convierte el campo Género de texto libre en una lista desplegable con géneros fijos."
  },
  "contributes": {
    "fields": [
      {
        "field": "genre",
        "control": "select",
        "options": [
          "Alternative Rock",
          "Ambient",
          "Blues",
          "Classical",
          "Country",
          "Electronic",
          "Folk",
          "Hip-Hop",
          "Indie",
          "Jazz",
          "Latin",
          "Metal",
          "Pop",
          "Progressive Rock",
          "Punk",
          "R&B",
          "Reggae",
          "Rock",
          "Soul",
          "Soundtrack",
          "World"
        ]
      }
    ]
  }
}
