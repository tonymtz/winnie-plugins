{
  "schema": 1,
  "id": "musicbrainz-lookup",
  "name": "MusicBrainz Lookup",
  "author": "Pawapps Team",
  "version": "1.0.0",
  "icon": "wand",
  "category": "tag-sources",
  "description": {
    "en": "Matches the track against MusicBrainz and fills in the tags that are still empty.",
