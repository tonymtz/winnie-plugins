  },
  "main": "main.js",
  "permissions": {
    "network": ["musicbrainz.org"]
  },
  "contributes": {
    "actions": [
      {
        "id": "fill-missing",
        "title": { "en": "Fill Missing Tags", "es": "Completar etiquetas" },
        "icon": "wand",
        "function": "fillMissingTags"
      }
    ]
  }
}
